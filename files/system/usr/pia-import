#!/usr/bin/env bash

set -euo pipefail

CONFIG="/var/lib/pia/pia.conf"

if [[ $EUID -ne 0 ]]; then
    echo "Run this command with sudo:"
    echo "  sudo pia-import"
    exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
    echo
    echo "PIA WireGuard configuration not found:"
    echo "  $CONFIG"
    echo
    echo "Generate it first using the PIA manual connection scripts."
    exit 1
fi

chmod 600 "$CONFIG"

echo "Removing existing PIA NetworkManager connection..."
nmcli connection delete "PIA" 2>/dev/null || true

echo "Importing PIA WireGuard configuration..."

nmcli connection import \
    type wireguard \
    file "$CONFIG"

IMPORTED="$(nmcli -t -f NAME connection show | grep '^pia$' || true)"

if [[ -n "$IMPORTED" ]]; then
    nmcli connection modify pia \
        connection.id "PIA" \
        connection.autoconnect no
else
    echo
    echo "NetworkManager imported the WireGuard connection,"
    echo "but its connection name was not 'pia'."
    echo
    echo "Run:"
    echo "  nmcli connection show"
    exit 1
fi

nmcli connection reload

echo
echo "PIA VPN imported successfully."
echo
echo "Connect:"
echo "  nmcli connection up PIA"
echo
echo "Disconnect:"
echo "  nmcli connection down PIA"
echo
echo "GNOME:"
echo "  Quick Settings → VPN → PIA"
